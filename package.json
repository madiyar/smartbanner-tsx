{
  "name": "smartbanner-tsx",
  "version": "0.0.0-development",
  "description": "Smart App Banner for React — lightweight, zero-dependency, SSR-safe and customizable",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/style.css",
    "./classic.css": "./dist/classic.css",
    "./dist/style.css": "./dist/style.css",
    "./dist/classic.css": "./dist/classic.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "build:docs": "vite build && node scripts/prerender.mjs",
    "preview:docs": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome ci",
    "format:fix": "biome check --write",
    "test": "vitest",
    "test:run": "vitest run",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "react",
    "smartbanner",
    "smart app banner",
    "smart-app-banner",
    "app banner",
    "app store banner",
    "google play banner",
    "ios",
    "android",
    "nextjs",
    "ssr",
    "typescript",
    "react-smartbanner",
    "smartbanner.js",
    "react smart app banner",
    "smartbanner react"
  ],
  "author": "madiyar (https://madiyar.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madiyar/smartbanner-tsx"
  },
  "bugs": "https://github.com/madiyar/smartbanner-tsx/issues",
  "homepage": "https://madiyar.github.io/smartbanner-tsx",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.4.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
